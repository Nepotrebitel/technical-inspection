# ==========================================
# 1. Node.js / Next.js (Фронтенд)
# ==========================================
# Зависимости
/node_modules
/.pnp
.pnp.js

# Сборка Next.js
/.next/
/out/
/build

# Переменные окружения (секреты!)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Логи
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ==========================================
# 2. Python (Бэкенд - папка tehplus-backend)
# ==========================================
# Виртуальное окружение
venv/
env/
.venv/
ENV/

# Кэш Python
__pycache__/
*.py[cod]
*$py.class
*.so

# Переменные окружения Python (если есть отдельные)
tehplus-backend/.env

# ==========================================
# 3. Редакторы и ОС (Общее)
# ==========================================
# VS Code (обычно игнорируют, если не хотите делиться настройками)
.vscode/*
!.vscode/extensions.json

# macOS
.DS_Store

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini

# ==========================================
